{
    "name": "sfambach/wp-tax-shipping",
    "description": "Taxmod Versand — compares the shipping rates of every connected carrier, buys the chosen one on the owner's click and prints its label on request.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "TaxmodShipping\\Core\\": "src/Core/",
            "TaxmodShipping\\WordPress\\": "src/WordPress/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaxmodShipping\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
